VITE_PORT=3004

# DOCKER
DOCKER_DATABASE_PORT="5441"
DOCKER_DATABASE_NAME="startui"
DOCKER_DATABASE_USERNAME="startui"
DOCKER_DATABASE_PASSWORD="startui"

DOCKER_MINIO_API_PORT="9010"
DOCKER_MINIO_UI_PORT="9011"
DOCKER_MINIO_USERNAME="minioadmin"
DOCKER_MINIO_PASSWORD="minioadmin"

DOCKER_MAILDEV_SMTP_PORT="1025"
DOCKER_MAILDEV_UI_PORT="1080"

# BASE URL
VITE_BASE_URL="http://localhost:${VITE_PORT}"

# S3 (optional): remove S3_HOST, the keys and VITE_S3_BUCKET_PUBLIC_URL to run
# without MinIO; the upload controls are then hidden
S3_BUCKET_NAME="default"
S3_HOST="127.0.0.1:${DOCKER_MINIO_API_PORT}"
S3_ACCESS_KEY_ID="startui-access-key"
S3_SECRET_ACCESS_KEY="startui-secret-key"
S3_SECURE=false
S3_FORCE_PATH_STYLE=true
VITE_S3_BUCKET_PUBLIC_URL="http://${S3_HOST}/${S3_BUCKET_NAME}"

# Use the following environment variables to show the environment name.
VITE_ENV_NAME="LOCAL"
VITE_ENV_EMOJI="🚧"
VITE_ENV_COLOR="gold"

# Configure demo mode (read only)
VITE_IS_DEMO="false"

# false: only existing users and invited people can sign in (Manager > Users >
# Invitations). true: anyone can create an account with the email code.
# Default until set in Manager → Configuración del Sistema → Seguridad y acceso
VITE_AUTH_SIGNUP_ENABLED="true"

# Old MySQL database: only to copy its data once into PostgreSQL
# (pnpm db:from-mysql, see docs/database.md)
# MYSQL_SOURCE_CONTAINER="mysql-docker"
# MYSQL_SOURCE_DATABASE="startui"
# MYSQL_SOURCE_USERNAME="startui"
# MYSQL_SOURCE_PASSWORD="startui"

# DATABASE
DATABASE_URL="postgresql://${DOCKER_DATABASE_USERNAME}:${DOCKER_DATABASE_PASSWORD}@localhost:${DOCKER_DATABASE_PORT}/${DOCKER_DATABASE_NAME}"
# Scratch database `prisma migrate dev` diffs against (it is wiped each time)
SHADOW_DATABASE_URL="postgresql://${DOCKER_DATABASE_USERNAME}:${DOCKER_DATABASE_PASSWORD}@localhost:${DOCKER_DATABASE_PORT}/${DOCKER_DATABASE_NAME}_shadow"

# AUTH
AUTH_SECRET="REPLACE ME" # You can use `npx @better-auth/cli@latest secret` to a generated secret
AUTH_SESSION_EXPIRATION_IN_SECONDS=2592000 # 30 days
AUTH_SESSION_UPDATE_AGE_IN_SECONDS=86400 # 1 day (every 1 day the session expiration is updated)
AUTH_TRUSTED_ORIGINS="start-ui-native://,start-ui-native://*" # Mobile app scheme for trustedOrigins config

# GITHUB
GITHUB_CLIENT_ID="REPLACE ME"
GITHUB_CLIENT_SECRET="REPLACE ME"

# EMAILS
# Defaults: Manager → Configuración del Sistema → Correo overrides them.
# Optional: without them emails are written to the log. In development an
# unreachable server (Maildev not running) also falls back to the log.
EMAIL_SERVER="smtp://0.0.0.0:${DOCKER_MAILDEV_SMTP_PORT}"
EMAIL_FROM="FlyNow Admin <noreply@example.com>"

# LOGGER
LOGGER_LEVEL="info"
LOGGER_PRETTY="true"
