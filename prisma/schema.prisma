// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/server/db/generated"
  moduleFormat = "esm"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Scratch database for `prisma migrate dev` (see docs/database.md)
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  // One schema per domain, Spanish names (see CLAUDE.md "Decisions")
  schemas           = ["identidad", "acceso", "configuracion", "demo", "personal", "organizacion", "movilidad", "parametrica"]
}

enum UserRole {
  user
  admin

  @@schema("identidad")
}

enum Genero {
  M
  F

  @@schema("personal")
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  email          String
  emailVerified  Boolean
  image          String?
  imageThumbnail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  accounts       Account[]

  role       UserRole?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?
  verifiedAt DateTime?

  // Two-factor authentication (TOTP app + backup codes)
  twoFactorEnabled Boolean?    @default(false)
  twoFactors       TwoFactor[]

  roles        UserRoleAssignment[]
  personalData PersonalData?

  permissionOverrides        UserPermissionOverride[] @relation("overrideUser")
  grantedPermissionOverrides UserPermissionOverride[] @relation("overrideGrantedBy")

  invitationsSent Invitation[] @relation("invitationsSent")

  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]

  @@unique([email])
  @@map("user")
  @@schema("identidad")
}

/// The person (personal.persona): stable anchor for HR, like the fun_id of
/// rr-hh. It may exist without an account (userId null), e.g. before the
/// person has an institutional email; the account, when there is one, is
/// linked here.
model PersonalData {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String?   @unique @db.Uuid
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  nombre               String?
  primerApellido       String?
  segundoApellido      String?
  tipoDocumento        String?
  /// C.I. without its complement; the key RR.HH. imports by
  numeroDocumento      String?   @unique
  /// Complement or place of issue of the C.I. (1B, LP…)
  complementoDocumento String?
  /// Institutional email: links the person to their account (identidad.user)
  /// as soon as one with this email exists
  correo               String?
  fechaNacimiento      DateTime?
  genero               Genero?
  telefono             String?
  telefonoAlternativo  String?
  pais                 String?
  departamento         String?
  ciudad               String?
  direccion            String?
  codigoPostal         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  asignaciones          Asignacion[]
  movimientos           Movimiento[]
  delegacionesDadas     Delegacion[] @relation("delegante")
  delegacionesRecibidas Delegacion[] @relation("delegado")

  @@map("persona")
  @@schema("personal")
}

enum RoleScope {
  local
  external

  @@schema("acceso")
}

// Invitation to join while public sign-up is closed: the invited email can
// create its account (signing in with the email code) and gets these roles
model Invitation {
  id          String          @id @default(uuid(7)) @db.Uuid
  email       String
  roles       Role[]
  // System the person is invited to (its roles only); null = this center
  systemId    String?         @db.Uuid
  system      ExternalSystem? @relation(fields: [systemId], references: [id], onDelete: Cascade)
  invitedById String?         @db.Uuid
  invitedBy   User?           @relation("invitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([email])
  @@index([systemId])
  @@map("invitation")
  @@schema("identidad")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
  @@schema("identidad")
}

model ExternalSystem {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  name                String                   @unique
  label               String?
  apiKey              String                   @unique @default(uuid())
  modules             ExternalModule[]
  roles               Role[]
  // OAuth client the system signs users in with, and the resource
  // (its API URL) that becomes the `aud` of its access tokens
  oauthClientId       String?                  @unique
  oauthClient         OauthClient?             @relation(fields: [oauthClientId], references: [clientId], onDelete: SetNull)
  resourceIdentifier  String?                  @unique
  // Confidential OAuth client the system's backend uses (client_credentials)
  // to call the external API, instead of the API key
  serviceClientId     String?                  @unique
  // Last time the system published its own module catalog (PUT
  // /external/modules). From then on its modules are edited in its code,
  // not here: the next publication would undo the changes.
  catalogSyncedAt     DateTime?
  permissionOverrides UserPermissionOverride[]
  invitations         Invitation[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@map("external_system")
  @@schema("acceso")
}

model ExternalModule {
  id       String         @id @default(uuid(7)) @db.Uuid
  systemId String         @db.Uuid
  system   ExternalSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  name     String
  actions  Json
  order    Int            @default(0)

  @@unique([systemId, name])
  @@map("external_module")
  @@schema("acceso")
}

model Role {
  id              String               @id @default(uuid(7)) @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  name            String               @unique
  description     String?
  scope           RoleScope            @default(local)
  systemId        String?              @db.Uuid
  externalSystem  ExternalSystem?      @relation(fields: [systemId], references: [id], onDelete: SetNull)
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  invitations Invitation[]

  @@map("role")
  @@schema("acceso")
}

model UserRoleAssignment {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignment")
  @@schema("acceso")
}

model Permission {
  id        String                   @id @default(uuid(7)) @db.Uuid
  subject   String
  action    String
  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@unique([subject, action])
  @@map("permission")
  @@schema("acceso")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
  @@schema("acceso")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Admin user id that impersonates the session
  impersonatedBy String? @db.Uuid

  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("identidad")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("identidad")
}

model Verification {
  id         String    @id @default(uuid(7)) @db.Uuid
  identifier String
  // Holds JSON payloads (e.g. OAuth authorization codes)
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("identidad")
}

model SystemConfig {
  // Fixed singleton row. Prisma cannot compare a UUID literal default written
  // as `@default("…")` on @db.Uuid (it would always report drift), so it is a
  // database default.
  id         String   @id @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  systemName String?
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("system_config")
  @@schema("configuracion")
}

// Who can get in and how: set from the manager; while there is no row the
// defaults in src/server/access-settings.ts apply
model AccessSettings {
  // Fixed singleton row (see SystemConfig)
  id                String   @id @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  // false: accounts only by invitation or created by an admin
  signupEnabled     Boolean
  // Email domains new accounts and invitations may use; empty: any
  allowedDomains    Json
  loginCodeMinutes  Int
  invitationDays    Int
  // off, managers (who can open the manager) or everyone
  twoFactorRequired String
  // How people sign in: a code sent by email, a password, or both
  emailCodeLogin    Boolean  @default(true)
  passwordLogin     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("access_settings")
  @@schema("configuracion")
}

// Mail settings saved from the manager; while there are none, the center
// sends with EMAIL_SERVER and EMAIL_FROM from the environment
model MailSettings {
  // Fixed singleton row (see SystemConfig)
  id          String   @id @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  // smtp sends; log writes the messages to the server log instead
  mailer      String   @default("smtp")
  host        String?
  port        Int?
  // auto (TLS on port 465, STARTTLS when the server offers it), starttls or tls
  encryption  String   @default("auto")
  username    String?
  // Encrypted with a key derived from AUTH_SECRET (src/server/secrets.ts)
  password    String?  @db.Text
  fromAddress String
  fromName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mail_settings")
  @@schema("configuracion")
}

model Book {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  author    String
  genre     Genre?   @relation(fields: [genreId], references: [id])
  genreId   String   @db.Uuid
  publisher String?
  coverId   String?

  @@unique([title, author])
  @@map("book")
  @@schema("demo")
}

model Author {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  @@map("author")
  @@schema("demo")
}

model Genre {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique
  color     String
  Book      Book[]

  @@map("genre")
  @@schema("demo")
}

model Publisher {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  @@map("publisher")
  @@schema("demo")
}

model Jwks {
  id         String    @id @db.Uuid
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?   @db.Text
  crv        String?   @db.Text

  @@map("jwks")
  @@schema("identidad")
}

model OauthClient {
  id                               String                @id @db.Uuid
  clientId                         String
  clientSecret                     String?               @db.Text
  clientDiscoveryId                String?               @db.Text
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?               @db.Text
  scopes                           String?
  clientCredentialsScopes          String?
  userId                           String?               @db.Uuid
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?               @db.Text
  uri                              String?               @db.Text
  icon                             String?               @db.Text
  contacts                         String?
  tos                              String?               @db.Text
  policy                           String?               @db.Text
  softwareId                       String?               @db.Text
  softwareVersion                  String?               @db.Text
  softwareStatement                String?               @db.Text
  redirectUris                     String
  postLogoutRedirectUris           String?
  backchannelLogoutUri             String?               @db.Text
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?               @db.Text
  applicationType                  String?               @db.Text
  jwks                             String?               @db.Text
  jwksUri                          String?               @db.Text
  grantTypes                       String?
  responseTypes                    String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?               @db.Text
  metadata                         String?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]
  externalSystem                   ExternalSystem?

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
  @@schema("identidad")
}

model OauthResource {
  id                            String                @id @db.Uuid
  identifier                    String
  name                          String                @db.Text
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?               @db.Text
  signingKeyId                  String?               @db.Text
  allowedScopes                 String?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      String?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
  @@schema("identidad")
}

model OauthClientResource {
  id            String        @id @db.Uuid
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      String?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
  @@schema("identidad")
}

model OauthRefreshToken {
  id                      String             @id @db.Uuid
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String             @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @db.Text
  authorizationCodeId     String?            @db.Text
  resources               String?
  requestedUserInfoClaims String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?            @db.Text
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
  @@schema("identidad")
}

model OauthAccessToken {
  id                      String             @id @db.Uuid
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @db.Uuid
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @db.Text
  authorizationCodeId     String?            @db.Text
  resources               String?
  requestedUserInfoClaims String?
  refreshId               String?            @db.Uuid
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            String?
  scopes                  String

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
  @@schema("identidad")
}

model OauthConsent {
  id                      String      @id @db.Uuid
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?     @db.Uuid
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @db.Text
  resources               String?
  requestedUserInfoClaims String?
  scopes                  String
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
  @@schema("identidad")
}

model OauthClientAssertion {
  id        String   @id @db.Uuid
  expiresAt DateTime

  @@map("oauthClientAssertion")
  @@schema("identidad")
}

enum PermissionEffect {
  grant
  deny

  @@schema("acceso")
}

// Privilege: grants or denies one permission to one user, on top of their
// roles, in one system (systemId null = the identity center itself).
// Effective permissions = roles + grants - denies (deny wins), expired
// privileges ignored.
model UserPermissionOverride {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation("overrideUser", fields: [userId], references: [id], onDelete: Cascade)
  systemId     String?          @db.Uuid
  system       ExternalSystem?  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  permissionId String           @db.Uuid
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       PermissionEffect
  reason       String?
  expiresAt    DateTime?
  grantedById  String?          @db.Uuid
  grantedBy    User?            @relation("overrideGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, systemId, permissionId])
  @@index([permissionId])
  @@map("user_permission_override")
  @@schema("acceso")
}

// ─── Human resources ─────────────────────────────────────────────────────────
// Schemas parametrica, organizacion and movilidad (personal.persona is the
// PersonalData model above). Column names are snake_case Spanish so the SQL
// functions in prisma/ddl read like those of rr-hh. Open-ended dates are NULL.
// See docs/rrhh.md.

/// Kind of bond of a post: item (planta), temporary contract, consultancy
model TipoVinculo {
  id          String   @id @default(uuid(7)) @db.Uuid
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  puestos     Puesto[]

  @@map("tipo_vinculo")
  @@schema("parametrica")
}

/// Kind of HR act that changes assignments (alta, rotación, baja…)
model TipoMovimiento {
  id          String       @id @default(uuid(7)) @db.Uuid
  codigo      String       @unique
  nombre      String
  descripcion String?
  activo      Boolean      @default(true)
  orden       Int          @default(0)
  movimientos Movimiento[]

  @@map("tipo_movimiento")
  @@schema("parametrica")
}

/// Level of a dependency in the organization chart
enum NivelDependencia {
  DIRECCION
  UNIDAD
  AREA

  @@schema("organizacion")
}

/// A box of the organization chart (DGE → unit → area). Renaming or closing
/// keeps the row: vigente_hasta closes it and a new row opens the next one.
model Dependencia {
  id            String           @id @default(uuid(7)) @db.Uuid
  codigo        String           @unique
  sigla         String?
  nombre        String
  nivel         NivelDependencia
  padreId       String?          @map("padre_id") @db.Uuid
  padre         Dependencia?     @relation("arbol", fields: [padreId], references: [id])
  hijas         Dependencia[]    @relation("arbol")
  orden         Int              @default(0)
  vigenteDesde  DateTime         @map("vigente_desde") @db.Date
  vigenteHasta  DateTime?        @map("vigente_hasta") @db.Date
  observaciones String?
  puestos       Puesto[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([padreId])
  @@map("dependencia")
  @@schema("organizacion")
}

/// A post of the structure: an item (planta) or a temporary post, with its
/// title and dependency. es_jefatura marks the head of that dependency.
model Puesto {
  id            String       @id @default(uuid(7)) @db.Uuid
  /// Key of the post in RR.HH.'s spreadsheet (IT-042 = item 42; EV-011-2026)
  codigo        String       @unique
  dependenciaId String       @map("dependencia_id") @db.Uuid
  dependencia   Dependencia  @relation(fields: [dependenciaId], references: [id])
  tipoVinculoId String       @map("tipo_vinculo_id") @db.Uuid
  tipoVinculo   TipoVinculo  @relation(fields: [tipoVinculoId], references: [id])
  /// Item number (planta) or contract number (eventual); null while unknown
  numero        String?
  denominacion  String
  esJefatura    Boolean      @default(false) @map("es_jefatura")
  vigenteDesde  DateTime     @map("vigente_desde") @db.Date
  vigenteHasta  DateTime?    @map("vigente_hasta") @db.Date
  observaciones String?
  asignaciones  Asignacion[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([dependenciaId])
  @@map("puesto")
  @@schema("organizacion")
}

/// How a person holds a post. Only TITULAR is exclusive per post and period
/// (an exclusion constraint in the migration); the others may overlap it.
enum TipoAsignacion {
  TITULAR
  INTERINO
  ROTACION
  COMISION
  SUPLENCIA

  @@schema("movilidad")
}

/// The HR act (memorándum, resolución) behind assignment changes
model Movimiento {
  id               String         @id @default(uuid(7)) @db.Uuid
  personaId        String         @map("persona_id") @db.Uuid
  persona          PersonalData   @relation(fields: [personaId], references: [id])
  tipoMovimientoId String         @map("tipo_movimiento_id") @db.Uuid
  tipoMovimiento   TipoMovimiento @relation(fields: [tipoMovimientoId], references: [id])
  fechaEfectiva    DateTime       @map("fecha_efectiva") @db.Date
  documento        String?
  observaciones    String?
  /// Account that registered it (null when loaded from a spreadsheet)
  registradoPorId  String?        @map("registrado_por_id") @db.Uuid
  abiertas         Asignacion[]   @relation("movimientoInicio")
  cerradas         Asignacion[]   @relation("movimientoFin")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([personaId, fechaEfectiva])
  @@map("movimiento")
  @@schema("movilidad")
}

/// Person ↔ post for a period: the mobility history. Never overwritten: a
/// change closes one row (hasta) and opens another.
model Asignacion {
  id                 String         @id @default(uuid(7)) @db.Uuid
  personaId          String         @map("persona_id") @db.Uuid
  persona            PersonalData   @relation(fields: [personaId], references: [id])
  puestoId           String         @map("puesto_id") @db.Uuid
  puesto             Puesto         @relation(fields: [puestoId], references: [id])
  tipo               TipoAsignacion
  desde              DateTime       @db.Date
  /// Last day in the post (inclusive); null: still in force
  hasta              DateTime?      @db.Date
  movimientoInicioId String?        @map("movimiento_inicio_id") @db.Uuid
  movimientoInicio   Movimiento?    @relation("movimientoInicio", fields: [movimientoInicioId], references: [id])
  movimientoFinId    String?        @map("movimiento_fin_id") @db.Uuid
  movimientoFin      Movimiento?    @relation("movimientoFin", fields: [movimientoFinId], references: [id])
  observaciones      String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@unique([personaId, puestoId, desde])
  @@index([puestoId, desde])
  @@map("asignacion")
  @@schema("movilidad")
}

/// Temporary cover of authority while someone is away (delegaciones of rr-hh)
model Delegacion {
  id                 String       @id @default(uuid(7)) @db.Uuid
  delegantePersonaId String       @map("delegante_persona_id") @db.Uuid
  delegante          PersonalData @relation("delegante", fields: [delegantePersonaId], references: [id])
  delegadoPersonaId  String       @map("delegado_persona_id") @db.Uuid
  delegado           PersonalData @relation("delegado", fields: [delegadoPersonaId], references: [id])
  motivo             String?
  documento          String?
  desde              DateTime     @db.Date
  /// Last day (inclusive); null until revoked
  hasta              DateTime?    @db.Date
  createdAt          DateTime     @default(now()) @map("created_at")

  @@unique([delegantePersonaId, delegadoPersonaId, desde])
  @@map("delegacion")
  @@schema("movilidad")
}
